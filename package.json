{
  "name": "strates",
  "version": "1.0.0",
  "description": "A web app to create and share Crystal code snippets.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugolgs-dev/strates.git"
  },
  "bugs": {
    "url": "https://github.com/hugolgs-dev/strates/issues"
  },
  "homepage": "https://github.com/hugolgs-dev/strates#readme",
  "scripts": {
    "build:js": "esbuild frontend/editor.js --bundle --format=esm --outfile=app/assets/javascript/vendor/editor.js --minify",
    "build:js:dev": "esbuild frontend/editor.js --bundle --format=esm --outfile=app/assets/javascript/vendor/editor.js --sourcemap",
    "watch:js": "esbuild frontend/editor.js --bundle --format=esm --outfile=app/assets/javascript/vendor/editor.js --sourcemap --watch"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
