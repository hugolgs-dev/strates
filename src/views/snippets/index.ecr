<p>
    <strong>Strates</strong> is a web app that lets you create and share
    <strong><a href="https://crystal-lang.org/" target="_blank" rel="noopener noreferrer">Crystal</a></strong>
    code snippets. It is inspired by
    <strong><a href="https://ellie-app.com/" target="_blank" rel="noopener noreferrer">Ellie</a></strong>
</p>

<button commandfor="new-strate-dialog" command="show-modal">New Strate</button>

<dialog id="new-strate-dialog" closedby="any">
  <div>
    <header><h3>New Strate</h3></header>
    <label>Name <input id="new-name" required></label>
    <label>Version
        <input id="new-version" list="crystal-versions"
               value="<%= Snippet::DEFAULT_CRYSTAL_VERSION %>" autocomplete="on">
        <datalist id="crystal-versions">
          <% CrystalVersions.all.each do |v| %><option value="<%= v %>"></option><% end %>
        </datalist>
    </label>
    <label>Code</label>
    <div id="new-editor" class="modal-editor"
        data-doc="<%= HTML.escape(Snippet::DEFAULT_CONTENT) %>"></div>
    <footer>
      <button type="button" commandfor="new-strate-dialog" command="close">Cancel</button>
      <button type="button" id="new-create" class="primary">Create</button>
    </footer>
  </div>
</dialog>

<button commandfor="howitworks-dialog" command="show-modal" class="outline">How Strates works</button>
<dialog id="howitworks-dialog" closedby="any">
  <form method="dialog">
    <header>
      <h3>How Strates works</h3>
    </header>
    <div>
      <p>TBD</p>
      <p class="small">Click confirm, outside the dialog or press Escape to close.</p>
    </div>
    <footer>
      <button type="button" commandfor="howitworks-dialog" command="close" class="primary">Close</button>
    </footer>
  </form>
</dialog>

<form method="get" action="/">
  <input type="search" name="q" value="<%= HTML.escape(params["q"]?.to_s) %>" placeholder="Search by name">
  <button type="submit">Search</button>
</form>

<form method="get" action="/">
  <input type="search" name="q" value="<%= HTML.escape(params["q"]?.to_s) %>" placeholder="Search by version">
  <button type="submit">Search</button>
</form>

<% if snippets.empty? %>
  <p>No snippets available</p>
<% else %>
  <div class="table">
    <table>
      <thead>
        <tr>
          <th>Slug</th>
          <th>Name</th>
          <th>Version</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% snippets.each do |snippet| %>
          <tr>
            <td><%= snippet.slug %></td>
            <td><%= HTML.escape(snippet.name) %></td>
            <td class="badge" data-variant="success"><%= HTML.escape(snippet.crystal_version) %></td>
            <td><a class="button" href="/<%= snippet.slug %>">View</a></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<script type="module">
  let view = null;

  const openBtn = document.querySelector('[commandfor="new-strate-dialog"][command="show-modal"]');
  const createBtn = document.querySelector("#new-create");

  // Deferred: the 400KB CodeMirror bundle is fetched the first time the dialog
  // opens, not on page load. Most visitors never open it.
  openBtn.addEventListener("click", async () => {
    if (view) {
      view.requestMeasure(); // re-measure on reopen
      return;
    }
    const { mountEditor } = await import("editor");
    const el = document.querySelector("#new-editor");
    view = mountEditor(el, el.dataset.doc);
    view.requestMeasure();
  });

  createBtn.addEventListener("click", async () => {
    if (!view) return; // editor not mounted yet
    createBtn.disabled = true;

    try {
      const res = await fetch("/strates", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: document.querySelector("#new-name").value,
          content: view.state.doc.toString(),
          crystal_version: document.querySelector("#new-version").value,
        }),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => null);
        const detail = body?.errors?.map((e) => `${e.field}: ${e.message}`).join("\n");
        alert(detail || `Failed to create strate (${res.status})`);
        return;
      }

      const { slug } = await res.json();
      window.location.href = "/" + slug;
    } catch (err) {
      console.error(err);
      alert("Failed to create strate");
    } finally {
      createBtn.disabled = false;
    }
  });
</script>
