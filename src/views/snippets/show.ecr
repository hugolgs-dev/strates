<div class="strate">
  <header class="strate-head">
    <div class="strate-title">
      <input id="strate-name" class="strate-name-input" value="<%= HTML.escape(snippet.name) %>">
      <span class="badge"><%= snippet.slug %></span>

      <select id="strate-version">
        <% CrystalVersions.all.each do |v| %>
          <option value="<%= v %>" <%= "selected" if v == snippet.crystal_version %>><%= v %></option>
        <% end %>
      </select>

      <form action="/<%= snippet.slug %>/fork" method="post" target="_blank" rel="noopener noreferrer">
        <%= csrf_tag %>
        <button type="submit" class="outline">Fork</button>
      </form>
    </div>

    <div class="buttons">
      <button class="primary" disabled title="Running snippets is not implemented yet">Run</button>
      <button id="save" class="outline">Save as new</button>
      <a class="button outline" href="/">Back</a>
    </div>
  </header>

  <section class="panes">
    <div class="pane">
      <div class="pane-label">Editor</div>
      <div class="code"
           data-doc="<%= HTML.escape(room.content) %>"
           data-version="<%= room.version %>"
           data-slug="<%= snippet.slug %>"></div>

    </div>
    <div class="pane">
        <div class="pane-label">Output</div>
        <div class="output" data-doc="<%= HTML.escape(snippet.content) %>"></div>
    </div>
  </section>
</div>

<script type="module">
  import { mountCollabEditor } from "editor";

  const store = {
    get(k) { try { return localStorage.getItem(k); } catch { return null; } },
    set(k, v) { try { localStorage.setItem(k, v); } catch {} },
  };

  const el = document.querySelector(".code");
  const name = store.get("strates-name") || prompt("Your name?") || "anon";
  store.set("strates-name", name);
  localStorage.setItem("strates-name", name);

  const view = mountCollabEditor(el, {
    doc: el.dataset.doc,
    version: Number(el.dataset.version),
    slug: el.dataset.slug,
    name,
  });

  const button = document.querySelector("#save");

  button.addEventListener("click", async () => {
    button.disabled = true;

    try {
      const res = await fetch("/<%= snippet.slug %>/save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: document.querySelector("#strate-name").value,
          content: view.state.doc.toString(),
          crystal_version: document.querySelector("#strate-version").value,
        }),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => null);
        const detail = body?.errors?.map((e) => `${e.field}: ${e.message}`).join("\n");
        alert(detail || `Save failed (${res.status})`);
        return;
      }

      const { slug } = await res.json();
      window.location.href = "/" + slug;
    } catch (err) {
      console.error(err);
      alert("Save failed");
    } finally {
      button.disabled = false;
    }
  });
</script>
